@echo off
setlocal
set "EC_SELF=%~f0"
set "EC_ARGS=%*"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t = Get-Content -LiteralPath $env:EC_SELF -Raw; $i = $t.IndexOf([string]::new([char]35,5) + 'PS' + [string]::new([char]35,5)); iex $t.Substring($i + 12)"
set "EC_CODE=%ERRORLEVEL%"
echo.
if /i not "%~1"=="/quiet" pause
exit /b %EC_CODE%
#####PS#####
# Fix Entity Compactor: replaces every old Entity Compactor jar in Minecraft 26.2 mods
# folders with the fixed build (works with Fabric Loader 0.19.5). Only entity-compactor
# jars are ever deleted.
$ErrorActionPreference = 'Continue'
$quiet = ($env:EC_ARGS -match '/quiet')
$profileName = 'allawi habib galbi abou husein'
$newName = 'entity-compactor-FIXED-26.2.jar'
$jarBytes = [Convert]::FromBase64String('')

Write-Host ''
Write-Host '  Entity Compactor fixer' -ForegroundColor Green
Write-Host '  ----------------------'
if (Get-Process -Name javaw, java -ErrorAction SilentlyContinue) {
  Write-Host '  Minecraft (Java) looks like it is running. Close the game first, then run this again.' -ForegroundColor Yellow
  if (-not $quiet) { exit 1 }
}

$home2 = $env:USERPROFILE
$roots = @($env:APPDATA, $env:LOCALAPPDATA, "$home2\curseforge", "$home2\Documents", "$home2\Desktop", "$home2\Downloads", "$home2\OneDrive") |
  Where-Object { $_ -and (Test-Path -LiteralPath $_) } | Select-Object -Unique

$targets = New-Object System.Collections.Generic.List[string]
Write-Host '  Looking for your mods folders (this can take a minute)...'
foreach ($root in $roots) {
  Get-ChildItem -LiteralPath $root -Filter 'entity-compactor*.jar' -Recurse -File -Depth 9 -ErrorAction SilentlyContinue |
    Where-Object { $_.Directory.Name -eq 'mods' } |
    ForEach-Object { if (-not $targets.Contains($_.DirectoryName)) { $targets.Add($_.DirectoryName) } }
  # The named profile's mods folder, even if Entity Compactor isn't in it yet.
  Get-ChildItem -LiteralPath $root -Directory -Recurse -Depth 6 -ErrorAction SilentlyContinue |
    Where-Object { $_.Name -eq $profileName } |
    ForEach-Object {
      foreach ($m in @("$($_.FullName)\mods", "$($_.FullName)\minecraft\mods", "$($_.FullName)\.minecraft\mods")) {
        if ((Test-Path -LiteralPath $m) -and -not $targets.Contains($m)) { $targets.Add($m) }
      }
    }
}

$done = 0
foreach ($dir in $targets) {
  $jars = Get-ChildItem -LiteralPath $dir -Filter '*.jar' -File -ErrorAction SilentlyContinue
  $names = $jars | ForEach-Object { $_.Name }
  # Leave 1.21.x profiles alone: they need the 1.21.4 build, not this one.
  $is121 = ($names | Where-Object { $_ -match '1\.21' }) -and -not ($names | Where-Object { $_ -match '26\.' })
  if ($is121) { Write-Host "  Skipped (looks like a 1.21 profile): $dir"; continue }
  $removed = @()
  foreach ($j in ($jars | Where-Object { $_.Name -like 'entity-compactor*.jar' })) {
    try { Remove-Item -LiteralPath $j.FullName -Force -ErrorAction Stop; $removed += $j.Name }
    catch { Write-Host "  Couldn't delete $($j.Name) (is the game open?)" -ForegroundColor Yellow }
  }
  [IO.File]::WriteAllBytes((Join-Path $dir $newName), $jarBytes)
  $done++
  Write-Host ''
  Write-Host "  Fixed: $dir" -ForegroundColor Green
  if ($removed) { Write-Host "    removed: $($removed -join ', ')" }
  Write-Host "    added:   $newName"
  if (-not ($names | Where-Object { $_ -like 'fabric-api*' })) {
    Write-Host '    Note: no Fabric API jar here. Add Fabric API for 26.2 too (modrinth.com/mod/fabric-api).' -ForegroundColor Yellow
  }
}

Write-Host ''
if ($done -eq 0) {
  Write-Host '  No Entity Compactor mods folder was found.' -ForegroundColor Yellow
  Write-Host "  Put $newName into your profile's mods folder by hand (it's saved next to this file)."
  [IO.File]::WriteAllBytes((Join-Path (Split-Path -Parent $env:EC_SELF) $newName), $jarBytes)
} else {
  Write-Host "  Done! Fixed $done mods folder(s). Start Minecraft 26.2 and type /compactor to turn it on or off." -ForegroundColor Green
}
Write-Host "EC_FIXED_COUNT=$done"
