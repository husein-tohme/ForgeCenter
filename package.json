{
  "name": "forgecenter",
  "version": "0.2.0",
  "description": "ForgeCenter - Minecraft mods, websites, bots, servers and an AI dev tutor in one place",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
