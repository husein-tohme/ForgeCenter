# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your site (and http://localhost:3000 for testing) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# More sign-in options. Each turns on when both values are set. The redirect URL to
# register with each provider is BASE_URL + /api/auth/<provider>/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# WhatsApp sign-in codes (WhatsApp Business Cloud API). Needs an approved
# "authentication" message template with a copy-code button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DAILY_LIMIT=300

# Comma-separated emails that can open the owner panel at /admin.
ADMIN_EMAILS=you@gmail.com

# Shown on the privacy page as the contact address.
CONTACT_EMAIL=

# Stripe: use a restricted key (rk_...). See README > Stripe for the permissions it needs
# (Checkout, Customers, Customer Portal, SetupIntents, PaymentMethods, Identity).
# Webhook secret comes from Developers > Webhooks.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email notifications (optional) through resend.com. EMAIL_FROM must use a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=ForgeCenter <orders@yourdomain.com>

# What only confirmed adults can buy (comma-separated product keys from src/catalog.js).
ADULT_ONLY_PRODUCTS=game,website,roblox,launcher

# Forge mentor and Forge Support (the AI that answers support tickets)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5
SUPPORT_AI_MODEL=claude-opus-5-5

# Encrypts customers' Discord bot tokens. Use a long random value (at least 32
# characters) and never change or lose it, or stored tokens can't be read.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# Minecraft server hosting through a Pterodactyl (or Pelican) panel.
PTERODACTYL_URL=https://panel.yourdomain.com
PTERODACTYL_APP_KEY=ptla_...
PTERODACTYL_CLIENT_KEY=ptlc_...
PTERODACTYL_NEST_ID=1
PTERODACTYL_EGG_ID=
PTERODACTYL_LOCATION_ID=1
# Optional: the address customers connect to (otherwise the allocation's alias or IP).
PTERODACTYL_PUBLIC_HOST=
# Optional: added to the server's start command. For Paper, "--max-players 10" enforces the plan's player limit.
PTERODACTYL_STARTUP_EXTRA=--max-players 10
MC_MEMORY_MB=2048
MC_DISK_MB=102400
MC_CPU_PERCENT=100

# Where the bot runner keeps each customer bot's database.
BOT_DATA_DIR=data/bots

# Where the SQLite database lives. Put it on a persistent disk in production.
DATABASE_PATH=data/forgecenter.db
