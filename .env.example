# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your site (and http://localhost:3000 for testing) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# More sign-in options. Each turns on when both values are set. The redirect URL to
# register with each provider is BASE_URL + /api/auth/<provider>/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# WhatsApp sign-in codes (WhatsApp Business Cloud API). Needs an approved
# "authentication" message template with a copy-code button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DAILY_LIMIT=300

# Comma-separated emails that can open the owner panel at /admin.
ADMIN_EMAILS=you@gmail.com

# Shown on the privacy page as the contact address.
CONTACT_EMAIL=

# Stripe: use a restricted key (rk_...) with write access to Checkout Sessions, Customers
# and Customer Portal sessions. Webhook secret comes from Developers > Webhooks.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email notifications (optional) through resend.com. EMAIL_FROM must use a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=ForgeCenter <orders@yourdomain.com>

# Forge mentor
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5

# Where the SQLite database lives. Put it on a persistent disk in production.
DATABASE_PATH=data/forgecenter.db
