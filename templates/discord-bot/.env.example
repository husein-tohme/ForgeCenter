# ---- Required ----
# Your bot's token. Developer Portal > your app > Bot > Reset Token.
# Keep this secret: anyone with it can control the bot.
DISCORD_TOKEN=

# Your Application ID. Developer Portal > your app > General Information.
# Needed by `npm run register`.
CLIENT_ID=

# ---- Optional ----
# The customer's server ID. When set, `npm run register` adds the slash
# commands to just that server, and they show up instantly.
# Leave empty to register commands globally (can take up to an hour).
GUILD_ID=

# Where the database file lives. Relative paths are inside this folder.
DATABASE_PATH=data/bot.db

# Economy: coins from /daily (before streak bonus) and for a right trivia answer.
DAILY_COINS=100
TRIVIA_REWARD=25

# Subreddits /meme picks from, comma separated. NSFW posts are always filtered out.
MEME_SUBREDDITS=wholesomememes,memes,MinecraftMemes
